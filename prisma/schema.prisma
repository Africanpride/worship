// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  email           String    @unique
  emailVerified   Boolean   @default(false)
  image           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  role            String?   @default("user")
  banned          Boolean?  @default(false)
  banReason       String?
  banExpires      DateTime?
  pendingDeletion Boolean?  @default(false)

  sessions    Session[]
  accounts    Account[]
  profile     Profile?
  reflections Reflection[]
  slots       EventSlot[]

  @@map("user")
}

model Profile {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String   @unique @db.ObjectId
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  username       String?  @unique
  displayName    String?
  firstName      String?
  lastName       String?
  phone          String?
  jobTitle       String?
  company        String?
  bio            String?  @db.String
  avatarUrl      String?
  bannerUrl      String?
  location       String?
  website        String?
  socialLinks    Json? // { twitter: "...", github: "...", linkedin: "..." }
  volunteerAreas String[]
  membershipPlan String?  @default("Basic")

  isPublic Boolean @default(true)
  theme    String  @default("system") // light/dark/system

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profiles")
}

model Session {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String   @db.ObjectId
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(auto()) @map("_id") @db.ObjectId
  accountId             String
  providerId            String
  userId                String    @db.ObjectId
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum VideoType {
  VOD
  LIVE
}

model Video {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  url       String
  thumbnail String?
  type      VideoType @default(VOD)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("videos")
}

model Event {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  slug            String   @unique
  startDate       DateTime
  endDate         DateTime
  poster          String? // URL to image
  description     String?
  tagline         String?
  location        String?
  category        String?
  registrationUrl String?
  status          String   @default("published") // draft, published, cancelled

  // Ministers: Embedded list for simplicity in MongoDB
  ministers Minister[]

  slots EventSlot[]

  // Sponsors: Array of ObjectIds for a Many-to-Many relation
  sponsorIds String[]  @db.ObjectId
  sponsors   Sponsor[] @relation(fields: [sponsorIds], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("events")
}

model Minister {
  id      String  @id @default(auto()) @map("_id") @db.ObjectId
  name    String
  role    String? // e.g., "Lead Pastor", "Guest Worship Leader"
  image   String?
  eventId String  @db.ObjectId
  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("ministers")
}

model Sponsor {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  name     String
  logo     String?
  website  String?
  eventIds String[] @db.ObjectId
  events   Event[]  @relation(fields: [eventIds], references: [id])

  @@map("sponsors")
}

model HeroSettings {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  videoSource String   @default("youtube") // youtube, mux, local
  videoId     String?
  videoUrl    String?
  startTime   Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@map("hero_settings")
}

model Reflection {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String   @db.String
  status    String   @default("pending") // pending, approved, archived
  featured  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("reflections")
}

model BlogPost {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String    @unique
  category    String
  excerpt     String
  content     String
  image       String?
  author      String?
  featured    Boolean   @default(false)
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("blog_posts")
}

model EventSlot {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  eventId          String   @db.ObjectId
  event            Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  startTime        DateTime
  endTime          DateTime
  status           String   @default("open") // open, booked, blocked
  assignedUserId   String?  @db.ObjectId
  assignedUser     User?    @relation(fields: [assignedUserId], references: [id])
  blockedByAdminId String?  @db.ObjectId
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([eventId])
  @@map("event_slots")
}

model SlotBookingHistory {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  slotId           String   @db.ObjectId
  previousUserId   String?  @db.ObjectId
  newUserId        String?  @db.ObjectId
  changedByAdminId String   @db.ObjectId // admin who performed the override
  reason           String?  @default("admin_override")
  createdAt        DateTime @default(now())

  @@index([slotId])
  @@map("slot_booking_history")
}

model BookingSettings {
  id                        String   @id @default(auto()) @map("_id") @db.ObjectId
  allowMultipleSlotsPerUser Boolean  @default(false)
  maxSlotsPerUser           Int? // only used if capped
  slotVisibility            String   @default("availability_only") // full_public | availability_only | admin_only
  updatedAt                 DateTime @updatedAt

  @@map("booking_settings")
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  email           String    @unique
  emailVerified   Boolean   @default(false)
  image           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  role            String?   @default("user")
  banned          Boolean?  @default(false)
  banReason       String?
  banExpires      DateTime?
  pendingDeletion Boolean?  @default(false)

  sessions               Session[]
  accounts               Account[]
  profile                Profile?
  reflections            Reflection[]
  slots                  EventSlot[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  calendarTokens         CalendarToken[]
  pushSubscriptions      PushSubscription[]

  @@map("user")
}

model Profile {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String   @unique @db.ObjectId
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  username       String?  @unique
  displayName    String?
  firstName      String?
  lastName       String?
  phone          String?
  jobTitle       String?
  company        String?
  bio            String?  @db.String
  avatarUrl      String?
  bannerUrl      String?
  location       String?
  country        String? // ISO-3166 alpha-3 (selected via CountryDropdown)
  website        String?
  socialLinks    Json? // { twitter: "...", github: "...", linkedin: "..." }
  volunteerAreas String[]
  membershipPlan String?  @default("Basic")

  isPublic Boolean @default(true)
  theme    String  @default("system") // light/dark/system

  phoneVerifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profiles")
}

model Session {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String   @db.ObjectId
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(auto()) @map("_id") @db.ObjectId
  accountId             String
  providerId            String
  userId                String    @db.ObjectId
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum VideoType {
  VOD
  LIVE
}

model Video {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  url       String
  thumbnail String?
  type      VideoType @default(VOD)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("videos")
}

model Event {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  slug            String   @unique
  startDate       DateTime
  endDate         DateTime
  poster          String? // URL to image
  description     String?
  tagline         String?
  location        String?
  category        String?
  registrationUrl String?
  status          String   @default("published") // draft, published, cancelled
  // Admin-controlled gate: bookings are only accepted while true.
  bookingOpen     Boolean  @default(false)

  // Ministers: Embedded list for simplicity in MongoDB
  ministers Minister[]

  slots EventSlot[]

  // Sponsors: Array of ObjectIds for a Many-to-Many relation
  sponsorIds String[]  @db.ObjectId
  sponsors   Sponsor[] @relation(fields: [sponsorIds], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("events")
}

model Minister {
  id      String  @id @default(auto()) @map("_id") @db.ObjectId
  name    String
  role    String? // e.g., "Lead Pastor", "Guest Worship Leader"
  image   String?
  eventId String  @db.ObjectId
  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("ministers")
}

model Sponsor {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  name     String
  logo     String?
  website  String?
  eventIds String[] @db.ObjectId
  events   Event[]  @relation(fields: [eventIds], references: [id])

  @@map("sponsors")
}

model HeroSettings {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  videoSource String   @default("youtube") // youtube, mux, local
  videoId     String?
  videoUrl    String?
  startTime   Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@map("hero_settings")
}

model Reflection {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String   @db.String
  status    String   @default("pending") // pending, approved, archived
  featured  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("reflections")
}

model BlogPost {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String    @unique
  category    String
  excerpt     String
  content     String
  image       String?
  author      String?
  featured    Boolean   @default(false)
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("blog_posts")
}

model EventSlot {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  eventId          String   @db.ObjectId
  event            Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  startTime        DateTime
  endTime          DateTime
  status           String   @default("open") // open, booked, blocked
  // Parallel ministry track this hour belongs to. Both tracks share the
  // event window; worship and Bible Reading happen simultaneously.
  track            String   @default("worship") // worship | bible-reading
  assignedUserId   String?  @db.ObjectId
  assignedUser     User?    @relation(fields: [assignedUserId], references: [id])
  blockedByAdminId String?  @db.ObjectId
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([eventId])
  @@index([startTime])
  @@index([track])
  @@map("event_slots")
}

model SlotBookingHistory {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  slotId           String   @db.ObjectId
  previousUserId   String?  @db.ObjectId
  newUserId        String?  @db.ObjectId
  changedByAdminId String   @db.ObjectId // admin who performed the override
  reason           String?  @default("admin_override")
  createdAt        DateTime @default(now())

  @@index([slotId])
  @@map("slot_booking_history")
}

model BookingSettings {
  id                        String   @id @default(auto()) @map("_id") @db.ObjectId
  allowMultipleSlotsPerUser Boolean  @default(false)
  maxSlotsPerUser           Int? // only used if capped
  slotVisibility            String   @default("availability_only") // full_public | availability_only | admin_only
  updatedAt                 DateTime @updatedAt

  @@map("booking_settings")
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  channel   String?  @default("inapp") // inapp | email | push | sms
  slotId    String?  @db.ObjectId
  eventId   String?  @db.ObjectId
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([slotId])
  @@index([eventId])
  @@map("notifications")
}

model NotificationPreference {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String   @unique @db.ObjectId
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailReminders Boolean  @default(true)
  pushReminders  Boolean  @default(false)
  smsReminders   Boolean  @default(false)
  updatedAt      DateTime @updatedAt

  @@map("notification_preferences")
}

model CalendarToken {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  userId         String    @db.ObjectId
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token          String    @unique
  createdAt      DateTime  @default(now())
  lastAccessedAt DateTime?
  revokedAt      DateTime?

  @@index([userId])
  @@map("calendar_tokens")
}

model PushSubscription {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Web Push (VAPID) — legacy
  endpoint  String?  @unique
  p256dh    String?
  auth      String?
  // FCM — for web + future mobile (Android/iOS)
  fcmToken  String?  @unique
  fid       String?
  platform  String?  @default("web") // web | android | ios
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("push_subscriptions")
}

model NotificationDedup {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  slotId    String   @db.ObjectId
  channel   String // inapp | email | push | sms
  triggerAt DateTime
  createdAt DateTime @default(now())

  @@unique([slotId, channel, triggerAt])
  @@index([triggerAt])
  @@map("notification_dedup")
}

model AdminNotificationSettings {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  singleton       String   @unique @default("singleton")
  emailEnabled    Boolean  @default(true)
  pushEnabled     Boolean  @default(false)
  smsEnabled      Boolean  @default(false)
  reminderOffsets Int[]    @default([1440, 60])
  updatedAt       DateTime @updatedAt
  updatedById     String?  @db.ObjectId

  @@map("admin_notification_settings")
}

model PhoneVerification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("phone_verifications")
}

model AppLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  ts        DateTime @default(now())
  level     String // error | warn | info | debug
  source    String // auth | slots | events | settings | email | db | system
  message   String
  detail    String?
  requestId String?
  userId    String?  @db.ObjectId
  meta      Json?

  // No @@index([ts]) on purpose: scripts/create-log-ttl.ts installs a TTL
  // variant of {ts:1}; a second plain index would conflict on every push.
  @@index([level])
  @@index([source])
  @@index([requestId])
  @@map("app_logs")
}

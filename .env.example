# OPENWA_BASE_URL=https://wa.thenonstop.org

# Firebase Cloud Messaging (FCM) — for web + future mobile (Android/iOS)
# Get from Firebase Console > Project Settings > General > Your apps > Web app > Config
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""
NEXT_PUBLIC_FCM_VAPID_KEY="" # Firebase Console > Cloud Messaging > Web Push certificates > Key Pair (or reuse VAPID_PUBLIC_KEY and Import existing)
# Server: use same Firebase project — service account JSON (Firebase Console > Project Settings > Service accounts > Generate new private key)
FIREBASE_SERVICE_ACCOUNT_JSON=''
# Alternative: individual fields (if not using JSON)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
